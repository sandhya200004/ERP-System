# Environment Configuration

# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://postgres:POLMOLG1234@localhost:5432/triverse_erp?schema=public"

# JWT Configuration - IMPORTANT: Generate new secrets for production using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@triverse-erp.com

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# PDF Generation
PDF_TEMP_DIR=./temp/pdf

# Logging
LOG_LEVEL=debug
