# ===================================
# MULTI-TENANT SAAS - ADDITIONAL ENV VARS
# Add these to your existing .env file
# ===================================

# ===================================
# MULTI-TENANT CONFIGURATION
# ===================================

# Base domain for multi-tenant subdomains
# Production: myerp.com (supports abc.myerp.com, xyz.myerp.com, admin.myerp.com)
# Development: localhost
BASE_DOMAIN=localhost
BASE_URL=http://localhost:3000

# ===================================
# SUBSCRIPTION & LIMITS
# ===================================

# Default plan for new companies
DEFAULT_SUBSCRIPTION_PLAN=trial

# Trial period (days)
TRIAL_PERIOD_DAYS=14

# Default limits per plan
DEFAULT_MAX_USERS=5
DEFAULT_MAX_BRANCHES=1
DEFAULT_MAX_STORAGE_GB=5

# Starter plan limits
STARTER_MAX_USERS=10
STARTER_MAX_BRANCHES=2
STARTER_MAX_STORAGE_GB=10

# Professional plan limits
PROFESSIONAL_MAX_USERS=50
PROFESSIONAL_MAX_BRANCHES=5
PROFESSIONAL_MAX_STORAGE_GB=50

# Enterprise plan limits
ENTERPRISE_MAX_USERS=1000
ENTERPRISE_MAX_BRANCHES=20
ENTERPRISE_MAX_STORAGE_GB=200

# ===================================
# EXAMPLE FULL .env FOR PRODUCTION
# ===================================

# Copy this section to your .env file and update values:

# NODE_ENV=production
# PORT=3000
# BASE_DOMAIN=myerp.com
# BASE_URL=https://myerp.com
# FRONTEND_URL=https://myerp.com
# DATABASE_URL=postgresql://erp_user:SecurePass123@localhost:5432/triverse_erp_prod
# JWT_SECRET=8a7d9f6e4c2b1a0d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5
# JWT_EXPIRES_IN=12h
# REFRESH_TOKEN_SECRET=1f2e3d4c5b6a7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d
# REFRESH_TOKEN_EXPIRES_IN=7d
# ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@myerp.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=TriVerse ERP <noreply@myerp.com>
# ALLOWED_ORIGINS=https://myerp.com,https://*.myerp.com
# COOKIE_SECURE=true
# SWAGGER_ENABLED=false
