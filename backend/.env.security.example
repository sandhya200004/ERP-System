# ================================
# Security Alert Configuration
# ================================

# Enable/disable alert channels
ENABLE_SLACK_ALERTS=false
ENABLE_EMAIL_ALERTS=false

# Slack webhook URL (create at https://api.slack.com/messaging/webhooks)
# Replace with your actual webhook URL
SLACK_WEBHOOK_URL=

# Email configuration (if using email alerts)
ALERT_EMAIL=security@triverse.com
SENDGRID_API_KEY=

# ================================
# Instructions:
# ================================
# 1. Copy this file to .env (without .example)
# 2. Set ENABLE_SLACK_ALERTS=true to enable Slack notifications
# 3. Add your SLACK_WEBHOOK_URL from https://api.slack.com/messaging/webhooks
# 4. Optionally enable email alerts with ENABLE_EMAIL_ALERTS=true
# 5. Restart backend: npm run start:dev
# 
# See SECURITY_SYSTEM_SETUP.md for full configuration guide
