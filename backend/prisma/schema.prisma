generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounts {
  id                String          @id @db.Uuid
  company_id        String          @db.Uuid
  account_number    String          @db.VarChar(50)
  name              String          @db.VarChar(255)
  account_type      account_type
  parent_account_id String?         @db.Uuid
  currency_code     String          @db.VarChar(3)
  is_active         Boolean         @default(true)
  is_system_account Boolean         @default(false)
  description       String?
  created_at        DateTime        @default(now())
  updated_at        DateTime
  deleted_at        DateTime?
  companies         companies       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  currencies        currencies      @relation(fields: [currency_code], references: [code])
  accounts          accounts?       @relation("accountsToaccounts", fields: [parent_account_id], references: [id])
  other_accounts    accounts[]      @relation("accountsToaccounts")
  journal_lines     journal_lines[]

  @@unique([company_id, account_number])
  @@index([account_type])
  @@index([company_id, deleted_at])
  @@index([parent_account_id])
}

model api_keys {
  id                    String    @id @db.Uuid
  company_id            String    @db.Uuid
  name                  String    @db.VarChar(255)
  key_hash              String    @unique @db.VarChar(255)
  key_prefix            String    @db.VarChar(20)
  permissions           Json?     @default("[]")
  rate_limit_per_minute Int       @default(60)
  is_active             Boolean   @default(true)
  last_used_at          DateTime?
  expires_at            DateTime?
  created_by            String    @db.Uuid
  created_at            DateTime  @default(now())
  updated_at            DateTime
  revoked_at            DateTime?
  companies             companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users                 users     @relation(fields: [created_by], references: [id])

  @@index([company_id])
  @@index([key_hash, revoked_at])
}

model attendance {
  id                  String    @id @db.Uuid
  user_id             String    @db.Uuid
  company_id          String    @db.Uuid
  date                DateTime  @db.Date
  check_in            DateTime
  check_out           DateTime?
  check_in_latitude   String?   @db.VarChar(50)
  check_in_longitude  String?   @db.VarChar(50)
  check_in_location   String?   @db.VarChar(255)
  check_in_notes      String?
  check_out_latitude  String?   @db.VarChar(50)
  check_out_longitude String?   @db.VarChar(50)
  check_out_notes     String?
  hours_worked        Decimal?  @db.Decimal(5, 2)
  created_at          DateTime  @default(now())
  updated_at          DateTime
  companies           companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users               users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([company_id, date])
  @@index([user_id, date])
}

model audit_logs {
  id          String       @id @db.Uuid
  company_id  String?      @db.Uuid
  user_id     String?      @db.Uuid
  action      audit_action
  entity_type String       @db.VarChar(100)
  entity_id   String?      @db.Uuid
  old_values  Json?
  new_values  Json?
  ip_address  String?      @db.VarChar(45)
  user_agent  String?
  created_at  DateTime     @default(now())
  companies   companies?   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users       users?       @relation(fields: [user_id], references: [id])

  @@index([action])
  @@index([company_id])
  @@index([created_at])
  @@index([entity_type, entity_id])
  @@index([user_id])
}

model branches {
  id               String             @id @db.Uuid
  company_id       String             @db.Uuid
  name             String             @db.VarChar(255)
  code             String             @db.VarChar(50)
  email            String?            @db.VarChar(255)
  phone            String?            @db.VarChar(50)
  address_line1    String?            @db.VarChar(255)
  address_line2    String?            @db.VarChar(255)
  city             String?            @db.VarChar(100)
  state            String?            @db.VarChar(100)
  postal_code      String?            @db.VarChar(20)
  country          String?            @db.VarChar(100)
  status           branch_status      @default(active)
  created_at       DateTime           @default(now())
  updated_at       DateTime
  deleted_at       DateTime?
  companies        companies          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  invoices         invoices[]
  number_sequences number_sequences[]
  quotes           quotes[]
  user_roles       user_roles[]

  @@unique([company_id, code])
  @@index([company_id, deleted_at])
  @@index([status])
}

model companies {
  id                    String                 @id @db.Uuid
  name                  String                 @db.VarChar(255)
  legal_name            String?                @db.VarChar(255)
  registration_number   String?                @db.VarChar(100)
  tax_id                String?                @db.VarChar(100)
  email                 String?                @db.VarChar(255)
  phone                 String?                @db.VarChar(50)
  website               String?                @db.VarChar(255)
  logo_url              String?
  address_line1         String?                @db.VarChar(255)
  address_line2         String?                @db.VarChar(255)
  city                  String?                @db.VarChar(100)
  state                 String?                @db.VarChar(100)
  postal_code           String?                @db.VarChar(20)
  country               String                 @default("US") @db.VarChar(100)
  default_currency_code String                 @default("USD") @db.VarChar(3)
  status                company_status         @default(active)
  settings              Json?                  @default("{}")
  created_at            DateTime               @default(now())
  updated_at            DateTime
  deleted_at            DateTime?
  accounts              accounts[]
  api_keys              api_keys[]
  attendance            attendance[]
  audit_logs            audit_logs[]
  branches              branches[]
  currencies            currencies             @relation(fields: [default_currency_code], references: [code])
  customers             customers[]
  employee_kpi_history  employee_kpi_history[]
  employee_tasks        employee_tasks[]
  invoices              invoices[]
  items                 items[]
  journal_entries       journal_entries[]
  kpi_tasks             kpi_tasks[]
  notifications         notifications[]
  number_sequences      number_sequences[]
  payments              payments[]
  public_leads          public_leads[]
  quotes                quotes[]
  role_kpi_configs      role_kpi_configs[]
  roles                 roles[]
  taxes                 taxes[]
  user_roles            user_roles[]
  vendors               vendors[]
  purchase_orders       purchase_orders[]
  goods_receipts        goods_receipts[]
  warehouses            warehouses[]
  stock_levels          stock_levels[]
  stock_movements       stock_movements[]

  @@index([status, deleted_at])
}

model currencies {
  code                                        String          @id @db.VarChar(3)
  name                                        String          @db.VarChar(100)
  symbol                                      String          @db.VarChar(10)
  decimal_places                              Int             @default(2)
  is_active                                   Boolean         @default(true)
  created_at                                  DateTime        @default(now())
  updated_at                                  DateTime
  accounts                                    accounts[]
  companies                                   companies[]
  customers                                   customers[]
  fx_rates_fx_rates_from_currencyTocurrencies fx_rates[]      @relation("fx_rates_from_currencyTocurrencies")
  fx_rates_fx_rates_to_currencyTocurrencies   fx_rates[]      @relation("fx_rates_to_currencyTocurrencies")
  invoices                                    invoices[]
  items                                       items[]
  journal_lines                               journal_lines[]
  payments                                    payments[]
  quotes                                      quotes[]
}

model customers {
  id                     String         @id @db.Uuid
  company_id             String         @db.Uuid
  customer_number        String         @db.VarChar(50)
  name                   String         @db.VarChar(255)
  customer_type          customer_type  @default(business)
  email                  String?        @db.VarChar(255)
  phone                  String?        @db.VarChar(50)
  website                String?        @db.VarChar(255)
  tax_id                 String?        @db.VarChar(100)
  billing_address_line1  String?        @db.VarChar(255)
  billing_address_line2  String?        @db.VarChar(255)
  billing_city           String?        @db.VarChar(100)
  billing_state          String?        @db.VarChar(100)
  billing_postal_code    String?        @db.VarChar(20)
  billing_country        String?        @db.VarChar(100)
  shipping_address_line1 String?        @db.VarChar(255)
  shipping_address_line2 String?        @db.VarChar(255)
  shipping_city          String?        @db.VarChar(100)
  shipping_state         String?        @db.VarChar(100)
  shipping_postal_code   String?        @db.VarChar(20)
  shipping_country       String?        @db.VarChar(100)
  default_currency_code  String?        @db.VarChar(3)
  payment_terms_days     Int?           @default(30)
  credit_limit           Decimal?       @db.Decimal(15, 2)
  notes                  String?
  created_at             DateTime       @default(now())
  updated_at             DateTime
  deleted_at             DateTime?
  companies              companies      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  currencies             currencies?    @relation(fields: [default_currency_code], references: [code])
  invoices               invoices[]
  payments               payments[]
  public_leads           public_leads[]
  quotes                 quotes[]

  @@unique([company_id, customer_number])
  @@index([company_id, deleted_at])
  @@index([customer_number])
  @@index([email])
}

model employee_profiles {
  id                      String              @id @default(uuid()) @db.Uuid
  user_id                 String              @unique @db.Uuid
  employee_id             String              @unique @db.VarChar(50)
  designation             String              @db.VarChar(100)
  department              String              @db.VarChar(100)
  role                    user_role_type
  date_of_joining         DateTime            @db.Date
  reporting_to_id         String?             @db.Uuid
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt
  employee_profiles       employee_profiles?  @relation("employee_profilesToemployee_profiles", fields: [reporting_to_id], references: [id])
  other_employee_profiles employee_profiles[] @relation("employee_profilesToemployee_profiles")
  users                   users               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([department])
  @@index([employee_id])
  @@index([role])
  @@index([designation], map: "idx_employee_profiles_designation")
  @@index([reporting_to_id], map: "idx_employee_profiles_reporting_to")
}

model employee_tasks {
  id                  String            @id @db.Uuid
  user_id             String            @db.Uuid
  company_id          String            @db.Uuid
  date                DateTime          @db.Date
  title               String            @db.VarChar(255)
  description         String?
  category            String?           @db.VarChar(100)
  priority            task_priority     @default(medium)
  status              task_status       @default(pending)
  hours_spent         Decimal           @default(0) @db.Decimal(5, 2)
  completed_at        DateTime?
  created_at          DateTime          @default(now())
  updated_at          DateTime
  deleted_at          DateTime?
  estimated_hours     Float?
  actual_hours        Float?
  started_at          DateTime?         @db.Timestamp(6)
  proofs              Json?             @default("[]")
  auto_checks         Json?             @default("{}")
  required_checks     Int?              @default(0)
  peer_reviews        Json?             @default("[]")
  quality_score       Float?
  penalty_pct         Float?            @default(0)
  task_score          Float?
  manager_approved    Boolean?          @default(false)
  manager_approved_at DateTime?         @db.Timestamp(6)
  assigned_to         String?           @db.Uuid
  created_by          String?           @db.Uuid
  submitted_at        DateTime?         @db.Timestamp(6)
  deadline            DateTime?         @db.Timestamp(6)
  manager_id          String?           @db.Uuid
  complexity          task_complexity?  @default(medium)
  companies           companies         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users               users             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  assigned_user       users?            @relation("assigned_tasks", fields: [assigned_to], references: [id], onUpdate: NoAction, map: "fk_assigned_to")
  creator             users?            @relation("created_tasks", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_created_by")
  manager             users?            @relation("managed_tasks", fields: [manager_id], references: [id], onUpdate: NoAction, map: "fk_manager_id")
  task_audit_log      task_audit_log[]
  task_audit_logs     task_audit_logs[]
  task_proofs         task_proofs[]

  @@index([company_id, date])
  @@index([status])
  @@index([user_id, date])
  @@index([assigned_to], map: "idx_tasks_assigned_to")
  @@index([completed_at], map: "idx_tasks_completed_at")
  @@index([complexity], map: "idx_tasks_complexity")
  @@index([created_by], map: "idx_tasks_created_by")
  @@index([deadline], map: "idx_tasks_deadline")
  @@index([manager_id], map: "idx_tasks_manager_id")
  @@index([submitted_at], map: "idx_tasks_submitted_at")
  @@index([task_score], map: "idx_tasks_task_score")
}

model fx_rates {
  id                                            String     @id @db.Uuid
  from_currency                                 String     @db.VarChar(3)
  to_currency                                   String     @db.VarChar(3)
  rate                                          Decimal    @db.Decimal(18, 6)
  effective_date                                DateTime   @db.Date
  created_at                                    DateTime   @default(now())
  currencies_fx_rates_from_currencyTocurrencies currencies @relation("fx_rates_from_currencyTocurrencies", fields: [from_currency], references: [code])
  currencies_fx_rates_to_currencyTocurrencies   currencies @relation("fx_rates_to_currencyTocurrencies", fields: [to_currency], references: [code])

  @@unique([from_currency, to_currency, effective_date])
  @@index([from_currency, to_currency, effective_date])
}

model invoice_line_taxes {
  id              String        @id @db.Uuid
  invoice_line_id String        @db.Uuid
  tax_id          String        @db.Uuid
  tax_rate        Decimal       @db.Decimal(5, 2)
  tax_amount      Decimal       @db.Decimal(15, 2)
  created_at      DateTime      @default(now())
  invoice_lines   invoice_lines @relation(fields: [invoice_line_id], references: [id], onDelete: Cascade)
  taxes           taxes         @relation(fields: [tax_id], references: [id])

  @@index([invoice_line_id])
}

model invoice_lines {
  id                 String               @id @db.Uuid
  invoice_id         String               @db.Uuid
  line_number        Int
  item_id            String?              @db.Uuid
  description        String
  quantity           Decimal              @db.Decimal(10, 2)
  unit_price         Decimal              @db.Decimal(15, 2)
  discount_percent   Decimal              @default(0) @db.Decimal(5, 2)
  discount_amount    Decimal              @default(0) @db.Decimal(15, 2)
  subtotal           Decimal              @db.Decimal(15, 2)
  tax_amount         Decimal              @default(0) @db.Decimal(15, 2)
  total              Decimal              @db.Decimal(15, 2)
  created_at         DateTime             @default(now())
  updated_at         DateTime
  invoice_line_taxes invoice_line_taxes[]
  invoices           invoices             @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  items              items?               @relation(fields: [item_id], references: [id])

  @@unique([invoice_id, line_number])
  @@index([invoice_id])
}

model invoices {
  id                                 String                 @id @db.Uuid
  company_id                         String                 @db.Uuid
  branch_id                          String?                @db.Uuid
  invoice_number                     String                 @db.VarChar(50)
  customer_id                        String                 @db.Uuid
  quote_id                           String?                @db.Uuid
  invoice_date                       DateTime               @db.Date
  due_date                           DateTime               @db.Date
  currency_code                      String                 @db.VarChar(3)
  fx_rate                            Decimal                @default(1.0) @db.Decimal(18, 6)
  subtotal                           Decimal                @default(0) @db.Decimal(15, 2)
  tax_total                          Decimal                @default(0) @db.Decimal(15, 2)
  discount_amount                    Decimal                @default(0) @db.Decimal(15, 2)
  total                              Decimal                @default(0) @db.Decimal(15, 2)
  amount_paid                        Decimal                @default(0) @db.Decimal(15, 2)
  amount_due                         Decimal                @default(0) @db.Decimal(15, 2)
  status                             invoice_status         @default(draft)
  notes                              String?
  terms                              String?
  journal_entry_id                   String?                @db.Uuid
  created_by                         String                 @db.Uuid
  finalized_at                       DateTime?
  finalized_by                       String?                @db.Uuid
  sent_at                            DateTime?
  created_at                         DateTime               @default(now())
  updated_at                         DateTime
  deleted_at                         DateTime?
  invoice_lines                      invoice_lines[]
  branches                           branches?              @relation(fields: [branch_id], references: [id])
  companies                          companies              @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users_invoices_created_byTousers   users                  @relation("invoices_created_byTousers", fields: [created_by], references: [id])
  currencies                         currencies             @relation(fields: [currency_code], references: [code])
  customers                          customers              @relation(fields: [customer_id], references: [id])
  users_invoices_finalized_byTousers users?                 @relation("invoices_finalized_byTousers", fields: [finalized_by], references: [id])
  journal_entries                    journal_entries?       @relation(fields: [journal_entry_id], references: [id])
  payment_applications               payment_applications[]
  quotes                             quotes[]

  @@unique([company_id, invoice_number])
  @@index([company_id, deleted_at])
  @@index([customer_id])
  @@index([due_date])
  @@index([invoice_date])
  @@index([status])
}

model item_taxes {
  item_id    String   @db.Uuid
  tax_id     String   @db.Uuid
  created_at DateTime @default(now())
  items      items    @relation(fields: [item_id], references: [id], onDelete: Cascade)
  taxes      taxes    @relation(fields: [tax_id], references: [id], onDelete: Cascade)

  @@id([item_id, tax_id])
}

model items {
  id                    String                 @id @db.Uuid
  company_id            String                 @db.Uuid
  item_number           String                 @db.VarChar(50)
  name                  String                 @db.VarChar(255)
  description           String?
  item_type             item_type              @default(goods)
  unit_price            Decimal                @db.Decimal(15, 2)
  cost_price            Decimal?               @db.Decimal(15, 2)
  default_currency_code String                 @db.VarChar(3)
  unit_of_measure       String?                @db.VarChar(50)
  sku                   String?                @db.VarChar(100)
  barcode               String?                @db.VarChar(100)
  is_active             Boolean                @default(true)
  created_at            DateTime               @default(now())
  updated_at            DateTime
  deleted_at            DateTime?
  invoice_lines         invoice_lines[]
  item_taxes            item_taxes[]
  companies             companies              @relation(fields: [company_id], references: [id], onDelete: Cascade)
  currencies            currencies             @relation(fields: [default_currency_code], references: [code])
  quote_lines           quote_lines[]
  purchase_order_lines  purchase_order_lines[]
  goods_receipt_lines   goods_receipt_lines[]
  stock_levels          stock_levels[]
  stock_movements       stock_movements[]

  @@unique([company_id, item_number])
  @@index([company_id, deleted_at])
  @@index([item_number])
  @@index([sku])
}

model journal_entries {
  id                                      String               @id @db.Uuid
  company_id                              String               @db.Uuid
  entry_number                            String               @db.VarChar(50)
  entry_date                              DateTime             @db.Date
  reference_type                          String?              @db.VarChar(50)
  reference_id                            String?              @db.Uuid
  description                             String?
  status                                  journal_entry_status @default(draft)
  posted_at                               DateTime?
  posted_by                               String?              @db.Uuid
  created_by                              String               @db.Uuid
  created_at                              DateTime             @default(now())
  updated_at                              DateTime
  invoices                                invoices[]
  companies                               companies            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users_journal_entries_created_byTousers users                @relation("journal_entries_created_byTousers", fields: [created_by], references: [id])
  users_journal_entries_posted_byTousers  users?               @relation("journal_entries_posted_byTousers", fields: [posted_by], references: [id])
  journal_lines                           journal_lines[]
  payments                                payments[]

  @@unique([company_id, entry_number])
  @@index([company_id])
  @@index([entry_date])
  @@index([reference_type, reference_id])
  @@index([status])
}

model journal_lines {
  id               String          @id @db.Uuid
  journal_entry_id String          @db.Uuid
  line_number      Int
  account_id       String          @db.Uuid
  debit_amount     Decimal         @default(0) @db.Decimal(15, 2)
  credit_amount    Decimal         @default(0) @db.Decimal(15, 2)
  currency_code    String          @db.VarChar(3)
  description      String?
  created_at       DateTime        @default(now())
  accounts         accounts        @relation(fields: [account_id], references: [id])
  currencies       currencies      @relation(fields: [currency_code], references: [code])
  journal_entries  journal_entries @relation(fields: [journal_entry_id], references: [id], onDelete: Cascade)

  @@unique([journal_entry_id, line_number])
  @@index([account_id])
  @@index([journal_entry_id])
}

model number_sequences {
  id            String    @id @db.Uuid
  company_id    String    @db.Uuid
  branch_id     String?   @db.Uuid
  document_type String    @db.VarChar(50)
  prefix        String?   @db.VarChar(20)
  next_number   Int       @default(1)
  padding       Int       @default(5)
  created_at    DateTime  @default(now())
  updated_at    DateTime
  branches      branches? @relation(fields: [branch_id], references: [id])
  companies     companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, branch_id, document_type])
}

model payment_applications {
  id           String   @id @db.Uuid
  payment_id   String   @db.Uuid
  invoice_id   String   @db.Uuid
  amount       Decimal  @db.Decimal(15, 2)
  fx_gain_loss Decimal  @default(0) @db.Decimal(15, 2)
  created_at   DateTime @default(now())
  invoices     invoices @relation(fields: [invoice_id], references: [id])
  payments     payments @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([invoice_id])
  @@index([payment_id])
}

model payments {
  id                   String                 @id @db.Uuid
  company_id           String                 @db.Uuid
  payment_number       String                 @db.VarChar(50)
  customer_id          String                 @db.Uuid
  payment_date         DateTime               @db.Date
  amount               Decimal                @db.Decimal(15, 2)
  currency_code        String                 @db.VarChar(3)
  fx_rate              Decimal                @default(1.0) @db.Decimal(18, 6)
  payment_method       payment_method         @default(bank_transfer)
  reference_number     String?                @db.VarChar(100)
  status               payment_status         @default(completed)
  notes                String?
  journal_entry_id     String?                @db.Uuid
  created_by           String                 @db.Uuid
  created_at           DateTime               @default(now())
  updated_at           DateTime
  deleted_at           DateTime?
  payment_applications payment_applications[]
  companies            companies              @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users                users                  @relation(fields: [created_by], references: [id])
  currencies           currencies             @relation(fields: [currency_code], references: [code])
  customers            customers              @relation(fields: [customer_id], references: [id])
  journal_entries      journal_entries?       @relation(fields: [journal_entry_id], references: [id])

  @@unique([company_id, payment_number])
  @@index([company_id, deleted_at])
  @@index([customer_id])
  @@index([payment_date])
}

model permissions {
  id               String             @id @db.Uuid
  name             String             @unique @db.VarChar(100)
  resource         String             @db.VarChar(100)
  action           String             @db.VarChar(50)
  description      String?
  created_at       DateTime           @default(now())
  role_permissions role_permissions[]

  @@index([resource])
}

model public_leads {
  id                       String     @id @db.Uuid
  company_id               String     @db.Uuid
  name                     String     @db.VarChar(255)
