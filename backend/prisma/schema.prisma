model notifications {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String     @db.Uuid
  company_id String?    @db.Uuid
  type       String     @db.VarChar(50)
  title      String     @db.VarChar(255)
