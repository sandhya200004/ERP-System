generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounts {
  id                String          @id @db.Uuid
  company_id        String          @db.Uuid
  account_number    String          @db.VarChar(50)
  name              String          @db.VarChar(255)
  account_type      account_type
  parent_account_id String?         @db.Uuid
  currency_code     String          @db.VarChar(3)
  is_active         Boolean         @default(true)
  is_system_account Boolean         @default(false)
  description       String?
  created_at        DateTime        @default(now())
  updated_at        DateTime
  deleted_at        DateTime?
  companies         companies       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  currencies        currencies      @relation(fields: [currency_code], references: [code])
  accounts          accounts?       @relation("accountsToaccounts", fields: [parent_account_id], references: [id])
  other_accounts    accounts[]      @relation("accountsToaccounts")
  journal_lines     journal_lines[]

  @@unique([company_id, account_number])
  @@index([account_type])
  @@index([company_id, deleted_at])
  @@index([parent_account_id])
}

model api_keys {
  id                    String    @id @db.Uuid
  company_id            String    @db.Uuid
  name                  String    @db.VarChar(255)
  key_hash              String    @unique @db.VarChar(255)
  key_prefix            String    @db.VarChar(20)
  permissions           Json?     @default("[]")
  rate_limit_per_minute Int       @default(60)
  is_active             Boolean   @default(true)
  last_used_at          DateTime?
  expires_at            DateTime?
  created_by            String    @db.Uuid
  created_at            DateTime  @default(now())
  updated_at            DateTime
  revoked_at            DateTime?
  companies             companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users                 users     @relation(fields: [created_by], references: [id])

  @@index([company_id])
  @@index([key_hash, revoked_at])
}

model attendance {
  id                  String    @id @db.Uuid
  user_id             String    @db.Uuid
  company_id          String    @db.Uuid
  date                DateTime  @db.Date
  check_in            DateTime
  check_out           DateTime?
  check_in_latitude   String?   @db.VarChar(50)
  check_in_longitude  String?   @db.VarChar(50)
  check_in_location   String?   @db.VarChar(255)
  check_in_notes      String?
  check_out_latitude  String?   @db.VarChar(50)
  check_out_longitude String?   @db.VarChar(50)
  check_out_notes     String?
  hours_worked        Decimal?  @db.Decimal(5, 2)
  created_at          DateTime  @default(now())
  updated_at          DateTime
  companies           companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users               users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([company_id, date])
  @@index([user_id, date])
}

model audit_logs {
  id          String       @id @db.Uuid
  company_id  String?      @db.Uuid
  user_id     String?      @db.Uuid
  action      audit_action
  entity_type String       @db.VarChar(100)
  entity_id   String?      @db.Uuid
  old_values  Json?
  new_values  Json?
  ip_address  String?      @db.VarChar(45)
  user_agent  String?
  created_at  DateTime     @default(now())
  companies   companies?   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users       users?       @relation(fields: [user_id], references: [id])

  @@index([action])
  @@index([company_id])
  @@index([created_at])
  @@index([entity_type, entity_id])
  @@index([user_id])
}

model branches {
  id               String             @id @db.Uuid
  company_id       String             @db.Uuid
  name             String             @db.VarChar(255)
  code             String             @db.VarChar(50)
  email            String?            @db.VarChar(255)
  phone            String?            @db.VarChar(50)
  address_line1    String?            @db.VarChar(255)
  address_line2    String?            @db.VarChar(255)
  city             String?            @db.VarChar(100)
  state            String?            @db.VarChar(100)
  postal_code      String?            @db.VarChar(20)
  country          String?            @db.VarChar(100)
  status           branch_status      @default(active)
  created_at       DateTime           @default(now())
  updated_at       DateTime
  deleted_at       DateTime?
  companies        companies          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  invoices         invoices[]
  number_sequences number_sequences[]
  quotes           quotes[]
  user_roles       user_roles[]

  @@unique([company_id, code])
  @@index([company_id, deleted_at])
  @@index([status])
}

model companies {
  id                    String             @id @db.Uuid
  name                  String             @db.VarChar(255)
  legal_name            String?            @db.VarChar(255)
  registration_number   String?            @db.VarChar(100)
  tax_id                String?            @db.VarChar(100)
  email                 String?            @db.VarChar(255)
  phone                 String?            @db.VarChar(50)
  website               String?            @db.VarChar(255)
  logo_url              String?
  address_line1         String?            @db.VarChar(255)
  address_line2         String?            @db.VarChar(255)
  city                  String?            @db.VarChar(100)
  state                 String?            @db.VarChar(100)
  postal_code           String?            @db.VarChar(20)
  country               String             @default("US") @db.VarChar(100)
  default_currency_code String             @default("USD") @db.VarChar(3)
  status                company_status     @default(active)
  settings              Json?              @default("{}")
  created_at            DateTime           @default(now())
  updated_at            DateTime
  deleted_at            DateTime?
  accounts              accounts[]
  api_keys              api_keys[]
  attendance            attendance[]
  audit_logs            audit_logs[]
  branches              branches[]
  currencies            currencies         @relation(fields: [default_currency_code], references: [code])
  customers             customers[]
  employee_tasks        employee_tasks[]
  invoices              invoices[]
  items                 items[]
  journal_entries       journal_entries[]
  number_sequences      number_sequences[]
  payments              payments[]
  public_leads          public_leads[]
  quotes                quotes[]
  roles                 roles[]
  taxes                 taxes[]
  user_roles            user_roles[]
  notifications         notifications[]
  employee_kpi_history  employee_kpi_history[]
  role_kpi_configs      role_kpi_configs[]
  task_audit_logs       task_audit_logs[]
  notification_settings notification_settings[]

  @@index([status, deleted_at])
}

model currencies {
  code                                        String          @id @db.VarChar(3)
  name                                        String          @db.VarChar(100)
  symbol                                      String          @db.VarChar(10)
  decimal_places                              Int             @default(2)
  is_active                                   Boolean         @default(true)
  created_at                                  DateTime        @default(now())
  updated_at                                  DateTime
  accounts                                    accounts[]
  companies                                   companies[]
  customers                                   customers[]
  fx_rates_fx_rates_from_currencyTocurrencies fx_rates[]      @relation("fx_rates_from_currencyTocurrencies")
  fx_rates_fx_rates_to_currencyTocurrencies   fx_rates[]      @relation("fx_rates_to_currencyTocurrencies")
  invoices                                    invoices[]
  items                                       items[]
  journal_lines                               journal_lines[]
  payments                                    payments[]
  quotes                                      quotes[]
}

model customers {
  id                     String         @id @db.Uuid
  company_id             String         @db.Uuid
  customer_number        String         @db.VarChar(50)
  name                   String         @db.VarChar(255)
  customer_type          customer_type  @default(business)
  email                  String?        @db.VarChar(255)
  phone                  String?        @db.VarChar(50)
  website                String?        @db.VarChar(255)
  tax_id                 String?        @db.VarChar(100)
  billing_address_line1  String?        @db.VarChar(255)
  billing_address_line2  String?        @db.VarChar(255)
  billing_city           String?        @db.VarChar(100)
  billing_state          String?        @db.VarChar(100)
  billing_postal_code    String?        @db.VarChar(20)
  billing_country        String?        @db.VarChar(100)
  shipping_address_line1 String?        @db.VarChar(255)
  shipping_address_line2 String?        @db.VarChar(255)
  shipping_city          String?        @db.VarChar(100)
  shipping_state         String?        @db.VarChar(100)
  shipping_postal_code   String?        @db.VarChar(20)
  shipping_country       String?        @db.VarChar(100)
  default_currency_code  String?        @db.VarChar(3)
  payment_terms_days     Int?           @default(30)
  credit_limit           Decimal?       @db.Decimal(15, 2)
  notes                  String?
  created_at             DateTime       @default(now())
  updated_at             DateTime
  deleted_at             DateTime?
  companies              companies      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  currencies             currencies?    @relation(fields: [default_currency_code], references: [code])
  invoices               invoices[]
  payments               payments[]
  public_leads           public_leads[]
  quotes                 quotes[]

  @@unique([company_id, customer_number])
  @@index([company_id, deleted_at])
  @@index([customer_number])
  @@index([email])
}

model employee_profiles {
  id                      String              @id @default(uuid()) @db.Uuid
  user_id                 String              @unique @db.Uuid
  employee_id             String              @unique @db.VarChar(50)
  designation             String              @db.VarChar(100)
  department              String              @db.VarChar(100)
  role                    user_role_type
  date_of_joining         DateTime            @db.Date
  reporting_to_id         String?             @db.Uuid
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt
  employee_profiles       employee_profiles?  @relation("employee_profilesToemployee_profiles", fields: [reporting_to_id], references: [id])
  other_employee_profiles employee_profiles[] @relation("employee_profilesToemployee_profiles")
  users                   users               @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([department])
  @@index([employee_id])
  @@index([role])
}

model employee_tasks {
  id                   String             @id @db.Uuid
  user_id              String             @db.Uuid
  company_id           String             @db.Uuid
  date                 DateTime           @db.Date
  title                String             @db.VarChar(255)
  description          String?
  category             String?            @db.VarChar(100)
  priority             task_priority      @default(medium)
  status               task_status        @default(pending)
  hours_spent          Decimal            @default(0) @db.Decimal(5, 2)
  completed_at         DateTime?
  created_at           DateTime           @default(now())
  updated_at           DateTime
  deleted_at           DateTime?
  assigned_to          String?            @db.Uuid
  created_by           String?            @db.Uuid
  estimated_hours      Decimal?           @db.Decimal(5, 2)
  actual_hours         Decimal?           @db.Decimal(5, 2)
  started_at           DateTime?
  submitted_at         DateTime?
  complexity           task_complexity?   @default(medium)
  deadline             DateTime?
  proofs               Json?              @default("[]")
  auto_checks          Json?              @default("[]")
  required_checks      Int?               @default(0)
  peer_reviews         Json?              @default("[]")
  quality_score        Decimal?           @db.Decimal(5, 2)
  penalty_pct          Decimal?           @default(0) @db.Decimal(5, 2)
  task_score           Decimal?           @db.Decimal(5, 2)
  manager_approved     Boolean?           @default(false)
  manager_approved_at  DateTime?
  manager_id           String?            @db.Uuid
  companies            companies          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users                users              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  assigned_user        users?             @relation("assigned_tasks", fields: [assigned_to], references: [id])
  creator              users?             @relation("created_tasks", fields: [created_by], references: [id])
  manager              users?             @relation("managed_tasks", fields: [manager_id], references: [id])
  task_proofs          task_proofs[]

  @@index([company_id, date])
  @@index([status])
  @@index([user_id, date])
  @@index([assigned_to])
  @@index([created_by])
  @@index([manager_id])
  @@index([deadline])
  @@index([complexity])
  @@index([submitted_at])
  @@index([task_score])
}

model fx_rates {
  id                                            String     @id @db.Uuid
  from_currency                                 String     @db.VarChar(3)
  to_currency                                   String     @db.VarChar(3)
  rate                                          Decimal    @db.Decimal(18, 6)
  effective_date                                DateTime   @db.Date
  created_at                                    DateTime   @default(now())
  currencies_fx_rates_from_currencyTocurrencies currencies @relation("fx_rates_from_currencyTocurrencies", fields: [from_currency], references: [code])
  currencies_fx_rates_to_currencyTocurrencies   currencies @relation("fx_rates_to_currencyTocurrencies", fields: [to_currency], references: [code])

  @@unique([from_currency, to_currency, effective_date])
  @@index([from_currency, to_currency, effective_date])
}

model invoice_line_taxes {
  id              String        @id @db.Uuid
  invoice_line_id String        @db.Uuid
  tax_id          String        @db.Uuid
  tax_rate        Decimal       @db.Decimal(5, 2)
  tax_amount      Decimal       @db.Decimal(15, 2)
  created_at      DateTime      @default(now())
  invoice_lines   invoice_lines @relation(fields: [invoice_line_id], references: [id], onDelete: Cascade)
  taxes           taxes         @relation(fields: [tax_id], references: [id])

  @@index([invoice_line_id])
}

model invoice_lines {
  id                 String               @id @db.Uuid
  invoice_id         String               @db.Uuid
  line_number        Int
  item_id            String?              @db.Uuid
  description        String
  quantity           Decimal              @db.Decimal(10, 2)
  unit_price         Decimal              @db.Decimal(15, 2)
  discount_percent   Decimal              @default(0) @db.Decimal(5, 2)
  discount_amount    Decimal              @default(0) @db.Decimal(15, 2)
  subtotal           Decimal              @db.Decimal(15, 2)
  tax_amount         Decimal              @default(0) @db.Decimal(15, 2)
  total              Decimal              @db.Decimal(15, 2)
  created_at         DateTime             @default(now())
  updated_at         DateTime
  invoice_line_taxes invoice_line_taxes[]
  invoices           invoices             @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  items              items?               @relation(fields: [item_id], references: [id])

  @@unique([invoice_id, line_number])
  @@index([invoice_id])
}

model invoices {
  id                                 String                 @id @db.Uuid
  company_id                         String                 @db.Uuid
  branch_id                          String?                @db.Uuid
  invoice_number                     String                 @db.VarChar(50)
  customer_id                        String                 @db.Uuid
  quote_id                           String?                @db.Uuid
  invoice_date                       DateTime               @db.Date
  due_date                           DateTime               @db.Date
  currency_code                      String                 @db.VarChar(3)
  fx_rate                            Decimal                @default(1.0) @db.Decimal(18, 6)
  subtotal                           Decimal                @default(0) @db.Decimal(15, 2)
  tax_total                          Decimal                @default(0) @db.Decimal(15, 2)
  discount_amount                    Decimal                @default(0) @db.Decimal(15, 2)
  total                              Decimal                @default(0) @db.Decimal(15, 2)
  amount_paid                        Decimal                @default(0) @db.Decimal(15, 2)
  amount_due                         Decimal                @default(0) @db.Decimal(15, 2)
  status                             invoice_status         @default(draft)
  notes                              String?
  terms                              String?
  journal_entry_id                   String?                @db.Uuid
  created_by                         String                 @db.Uuid
  finalized_at                       DateTime?
  finalized_by                       String?                @db.Uuid
  sent_at                            DateTime?
  created_at                         DateTime               @default(now())
  updated_at                         DateTime
  deleted_at                         DateTime?
  invoice_lines                      invoice_lines[]
  branches                           branches?              @relation(fields: [branch_id], references: [id])
  companies                          companies              @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users_invoices_created_byTousers   users                  @relation("invoices_created_byTousers", fields: [created_by], references: [id])
  currencies                         currencies             @relation(fields: [currency_code], references: [code])
  customers                          customers              @relation(fields: [customer_id], references: [id])
  users_invoices_finalized_byTousers users?                 @relation("invoices_finalized_byTousers", fields: [finalized_by], references: [id])
  journal_entries                    journal_entries?       @relation(fields: [journal_entry_id], references: [id])
  payment_applications               payment_applications[]
  quotes                             quotes[]

  @@unique([company_id, invoice_number])
  @@index([company_id, deleted_at])
  @@index([customer_id])
  @@index([due_date])
  @@index([invoice_date])
  @@index([status])
}

model item_taxes {
  item_id    String   @db.Uuid
  tax_id     String   @db.Uuid
  created_at DateTime @default(now())
  items      items    @relation(fields: [item_id], references: [id], onDelete: Cascade)
  taxes      taxes    @relation(fields: [tax_id], references: [id], onDelete: Cascade)

  @@id([item_id, tax_id])
}

model items {
  id                    String          @id @db.Uuid
  company_id            String          @db.Uuid
  item_number           String          @db.VarChar(50)
  name                  String          @db.VarChar(255)
  description           String?
  item_type             item_type       @default(goods)
  unit_price            Decimal         @db.Decimal(15, 2)
  cost_price            Decimal?        @db.Decimal(15, 2)
  default_currency_code String          @db.VarChar(3)
  unit_of_measure       String?         @db.VarChar(50)
  sku                   String?         @db.VarChar(100)
  barcode               String?         @db.VarChar(100)
  is_active             Boolean         @default(true)
  created_at            DateTime        @default(now())
  updated_at            DateTime
  deleted_at            DateTime?
  invoice_lines         invoice_lines[]
  item_taxes            item_taxes[]
  companies             companies       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  currencies            currencies      @relation(fields: [default_currency_code], references: [code])
  quote_lines           quote_lines[]

  @@unique([company_id, item_number])
  @@index([company_id, deleted_at])
  @@index([item_number])
  @@index([sku])
}

model journal_entries {
  id                                      String               @id @db.Uuid
  company_id                              String               @db.Uuid
  entry_number                            String               @db.VarChar(50)
  entry_date                              DateTime             @db.Date
  reference_type                          String?              @db.VarChar(50)
  reference_id                            String?              @db.Uuid
  description                             String?
  status                                  journal_entry_status @default(draft)
  posted_at                               DateTime?
  posted_by                               String?              @db.Uuid
  created_by                              String               @db.Uuid
  created_at                              DateTime             @default(now())
  updated_at                              DateTime
  invoices                                invoices[]
  companies                               companies            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users_journal_entries_created_byTousers users                @relation("journal_entries_created_byTousers", fields: [created_by], references: [id])
  users_journal_entries_posted_byTousers  users?               @relation("journal_entries_posted_byTousers", fields: [posted_by], references: [id])
  journal_lines                           journal_lines[]
  payments                                payments[]

  @@unique([company_id, entry_number])
  @@index([company_id])
  @@index([entry_date])
  @@index([reference_type, reference_id])
  @@index([status])
}

model journal_lines {
  id               String          @id @db.Uuid
  journal_entry_id String          @db.Uuid
  line_number      Int
  account_id       String          @db.Uuid
  debit_amount     Decimal         @default(0) @db.Decimal(15, 2)
  credit_amount    Decimal         @default(0) @db.Decimal(15, 2)
  currency_code    String          @db.VarChar(3)
  description      String?
  created_at       DateTime        @default(now())
  accounts         accounts        @relation(fields: [account_id], references: [id])
  currencies       currencies      @relation(fields: [currency_code], references: [code])
  journal_entries  journal_entries @relation(fields: [journal_entry_id], references: [id], onDelete: Cascade)

  @@unique([journal_entry_id, line_number])
  @@index([account_id])
  @@index([journal_entry_id])
}

model number_sequences {
  id            String    @id @db.Uuid
  company_id    String    @db.Uuid
  branch_id     String?   @db.Uuid
  document_type String    @db.VarChar(50)
  prefix        String?   @db.VarChar(20)
  next_number   Int       @default(1)
  padding       Int       @default(5)
  created_at    DateTime  @default(now())
  updated_at    DateTime
  branches      branches? @relation(fields: [branch_id], references: [id])
  companies     companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, branch_id, document_type])
}

model payment_applications {
  id           String   @id @db.Uuid
  payment_id   String   @db.Uuid
  invoice_id   String   @db.Uuid
  amount       Decimal  @db.Decimal(15, 2)
  fx_gain_loss Decimal  @default(0) @db.Decimal(15, 2)
  created_at   DateTime @default(now())
  invoices     invoices @relation(fields: [invoice_id], references: [id])
  payments     payments @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([invoice_id])
  @@index([payment_id])
}

model payments {
  id                   String                 @id @db.Uuid
  company_id           String                 @db.Uuid
  payment_number       String                 @db.VarChar(50)
  customer_id          String                 @db.Uuid
  payment_date         DateTime               @db.Date
  amount               Decimal                @db.Decimal(15, 2)
  currency_code        String                 @db.VarChar(3)
  fx_rate              Decimal                @default(1.0) @db.Decimal(18, 6)
  payment_method       payment_method         @default(bank_transfer)
  reference_number     String?                @db.VarChar(100)
  status               payment_status         @default(completed)
  notes                String?
  journal_entry_id     String?                @db.Uuid
  created_by           String                 @db.Uuid
  created_at           DateTime               @default(now())
  updated_at           DateTime
  deleted_at           DateTime?
  payment_applications payment_applications[]
  companies            companies              @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users                users                  @relation(fields: [created_by], references: [id])
  currencies           currencies             @relation(fields: [currency_code], references: [code])
  customers            customers              @relation(fields: [customer_id], references: [id])
  journal_entries      journal_entries?       @relation(fields: [journal_entry_id], references: [id])

  @@unique([company_id, payment_number])
  @@index([company_id, deleted_at])
  @@index([customer_id])
  @@index([payment_date])
}

model permissions {
  id               String             @id @db.Uuid
  name             String             @unique @db.VarChar(100)
  resource         String             @db.VarChar(100)
  action           String             @db.VarChar(50)
  description      String?
  created_at       DateTime           @default(now())
  role_permissions role_permissions[]

  @@index([resource])
}

model public_leads {
  id                       String     @id @db.Uuid
  company_id               String     @db.Uuid
  name                     String     @db.VarChar(255)
  email                    String     @db.VarChar(255)
  phone                    String?    @db.VarChar(50)
  company_name             String?    @db.VarChar(255)
  message                  String?
  source                   String?    @db.VarChar(100)
  status                   String     @default("new") @db.VarChar(50)
  converted_to_customer_id String?    @db.Uuid
  created_at               DateTime   @default(now())
  updated_at               DateTime
  companies                companies  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  customers                customers? @relation(fields: [converted_to_customer_id], references: [id])

  @@index([company_id])
  @@index([email])
  @@index([status])
}

model quote_line_taxes {
  id            String      @id @db.Uuid
  quote_line_id String      @db.Uuid
  tax_id        String      @db.Uuid
  tax_rate      Decimal     @db.Decimal(5, 2)
  tax_amount    Decimal     @db.Decimal(15, 2)
  created_at    DateTime    @default(now())
  quote_lines   quote_lines @relation(fields: [quote_line_id], references: [id], onDelete: Cascade)
  taxes         taxes       @relation(fields: [tax_id], references: [id])

  @@index([quote_line_id])
}

model quote_lines {
  id               String             @id @db.Uuid
  quote_id         String             @db.Uuid
  line_number      Int
  item_id          String?            @db.Uuid
  description      String
  quantity         Decimal            @db.Decimal(10, 2)
  unit_price       Decimal            @db.Decimal(15, 2)
  discount_percent Decimal            @default(0) @db.Decimal(5, 2)
  discount_amount  Decimal            @default(0) @db.Decimal(15, 2)
  subtotal         Decimal            @db.Decimal(15, 2)
  tax_amount       Decimal            @default(0) @db.Decimal(15, 2)
  total            Decimal            @db.Decimal(15, 2)
  created_at       DateTime           @default(now())
  updated_at       DateTime
  quote_line_taxes quote_line_taxes[]
  items            items?             @relation(fields: [item_id], references: [id])
  quotes           quotes             @relation(fields: [quote_id], references: [id], onDelete: Cascade)

  @@unique([quote_id, line_number])
  @@index([quote_id])
}

model quotes {
  id                      String        @id @db.Uuid
  company_id              String        @db.Uuid
  branch_id               String?       @db.Uuid
  quote_number            String        @db.VarChar(50)
  customer_id             String        @db.Uuid
  quote_date              DateTime      @db.Date
  valid_until             DateTime?     @db.Date
  currency_code           String        @db.VarChar(3)
  fx_rate                 Decimal       @default(1.0) @db.Decimal(18, 6)
  subtotal                Decimal       @default(0) @db.Decimal(15, 2)
  tax_total               Decimal       @default(0) @db.Decimal(15, 2)
  discount_amount         Decimal       @default(0) @db.Decimal(15, 2)
  total                   Decimal       @default(0) @db.Decimal(15, 2)
  status                  quote_status  @default(draft)
  notes                   String?
  terms                   String?
  created_by              String        @db.Uuid
  sent_at                 DateTime?
  accepted_at             DateTime?
  converted_to_invoice_id String?       @db.Uuid
  created_at              DateTime      @default(now())
  updated_at              DateTime
  deleted_at              DateTime?
  quote_lines             quote_lines[]
  branches                branches?     @relation(fields: [branch_id], references: [id])
  companies               companies     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  invoices                invoices?     @relation(fields: [converted_to_invoice_id], references: [id])
  users                   users         @relation(fields: [created_by], references: [id])
  currencies              currencies    @relation(fields: [currency_code], references: [code])
  customers               customers     @relation(fields: [customer_id], references: [id])

  @@unique([company_id, quote_number])
  @@index([company_id, deleted_at])
  @@index([customer_id])
  @@index([quote_date])
  @@index([status])
}

model refresh_tokens {
  id         String    @id @db.Uuid
  user_id    String    @db.Uuid
  token      String    @unique @db.VarChar(500)
  expires_at DateTime
  created_at DateTime  @default(now())
  revoked_at DateTime?
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token, revoked_at])
  @@index([user_id])
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  created_at    DateTime    @default(now())
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
}

model roles {
  id               String             @id @db.Uuid
  company_id       String             @db.Uuid
  name             String             @db.VarChar(100)
  description      String?
  is_system_role   Boolean            @default(false)
  created_at       DateTime           @default(now())
  updated_at       DateTime
  role_permissions role_permissions[]
  companies        companies          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user_roles       user_roles[]

  @@unique([company_id, name])
  @@index([company_id])
}

model taxes {
  id                 String               @id @db.Uuid
  company_id         String               @db.Uuid
  name               String               @db.VarChar(100)
  tax_type           tax_type             @default(other)
  rate               Decimal              @db.Decimal(5, 2)
  jurisdiction       String?              @db.VarChar(100)
  description        String?
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(now())
  updated_at         DateTime
  deleted_at         DateTime?
  invoice_line_taxes invoice_line_taxes[]
  item_taxes         item_taxes[]
  quote_line_taxes   quote_line_taxes[]
  companies          companies            @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id, deleted_at])
}

model user_roles {
  id         String    @id @db.Uuid
  user_id    String    @db.Uuid
  role_id    String    @db.Uuid
  company_id String    @db.Uuid
  branch_id  String?   @db.Uuid
  created_at DateTime  @default(now())
  branches   branches? @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  companies  companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  roles      roles     @relation(fields: [role_id], references: [id], onDelete: Cascade)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id, company_id, branch_id])
  @@index([company_id])
  @@index([user_id])
}

model users {
  id                                                String             @id @default(uuid()) @db.Uuid
  email                                             String             @unique @db.VarChar(255)
  password_hash                                     String             @db.VarChar(255)
  first_name                                        String             @db.VarChar(100)
  last_name                                         String             @db.VarChar(100)
  phone                                             String?            @db.VarChar(50)
  avatar_url                                        String?
  status                                            user_status        @default(active)
  last_login_at                                     DateTime?
  email_verified_at                                 DateTime?
  two_factor_enabled                                Boolean            @default(false)
  two_factor_secret                                 String?            @db.VarChar(255)
  created_at                                        DateTime           @default(now())
  updated_at                                        DateTime           @updatedAt
  deleted_at                                        DateTime?
  api_keys                                          api_keys[]
  attendance                                        attendance[]
  audit_logs                                        audit_logs[]
  employee_profiles                                 employee_profiles?
  employee_tasks                                    employee_tasks[]
  assigned_tasks                                    employee_tasks[]   @relation("assigned_tasks")
  created_tasks                                     employee_tasks[]   @relation("created_tasks")
  managed_tasks                                     employee_tasks[]   @relation("managed_tasks")
  invoices_invoices_created_byTousers               invoices[]         @relation("invoices_created_byTousers")
  invoices_invoices_finalized_byTousers             invoices[]         @relation("invoices_finalized_byTousers")
  journal_entries_journal_entries_created_byTousers journal_entries[]  @relation("journal_entries_created_byTousers")
  journal_entries_journal_entries_posted_byTousers  journal_entries[]  @relation("journal_entries_posted_byTousers")
  payments                                          payments[]
  quotes                                            quotes[]
  refresh_tokens                                    refresh_tokens[]
  user_roles                                        user_roles[]
  notifications                                     notifications[]
  task_proofs                                       task_proofs[]
  employee_kpi_history                              employee_kpi_history[]
  task_audit_logs                                   task_audit_logs[]
  notification_settings                             notification_settings?

  @@index([email, deleted_at])
  @@index([status])
}

enum account_type {
  asset
  liability
  equity
  revenue
  expense
}

enum audit_action {
  create
  update
  delete
  status_change
  login
  logout
  enable_feature
  disable_feature
  bulk_update
}

enum branch_status {
  active
  inactive
}

enum company_status {
  active
  inactive
  trial
}

enum customer_type {
  individual
  business
}

enum invoice_status {
  draft
  final
  sent
  partially_paid
  paid
  overdue
  cancelled
}

enum item_type {
  goods
  service
}

enum journal_entry_status {
  draft
  posted
  voided
}

enum payment_method {
  cash
  bank_transfer
  credit_card
  debit_card
  cheque
  other
}

enum payment_status {
  pending
  completed
  failed
  cancelled
}

enum quote_status {
  draft
  sent
  accepted
  rejected
  expired
  converted
}

enum task_priority {
  low
  medium
  high
}

enum task_complexity {
  trivial
  small
  medium
  complex
  critical
}

enum task_status {
  pending
  in_progress
  completed
  cancelled
  submitted
  approved
  rejected
}

enum tax_type {
  gst
  vat
  sales_tax
  other
}

enum user_role_type {
  CEO
  CTO
  CMO
  HR
  MANAGER
  DEVELOPER
  DESIGNER
  MARKETING
  RND
  EMPLOYEE
}

enum user_status {
  active
  inactive
  suspended
}

model notifications {
  id           String    @id @db.Uuid
  user_id      String    @db.Uuid
  company_id   String    @db.Uuid
  title        String    @db.VarChar(255)
  message      String
  type         String    @db.VarChar(50)
  is_read      Boolean   @default(false)
  read_at      DateTime?
  action_url   String?   @db.VarChar(500)
  created_at   DateTime  @default(now())
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  companies    companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
  @@index([company_id])
  @@index([created_at])
}

model task_proofs {
  id             String         @id @db.Uuid
  task_id        String         @db.Uuid
  file_name      String         @db.VarChar(255)
  file_path      String         @db.VarChar(500)
  file_size      BigInt
  mime_type      String         @db.VarChar(100)
  uploaded_by    String         @db.Uuid
  uploaded_at    DateTime       @default(now())
  task           employee_tasks @relation(fields: [task_id], references: [id], onDelete: Cascade)
  uploader       users          @relation(fields: [uploaded_by], references: [id])

  @@index([task_id])
  @@index([uploaded_by])
}

model employee_kpi_history {
  id                    String    @id @db.Uuid
  employee_id           String    @db.Uuid
  company_id            String    @db.Uuid
  period_start          DateTime  @db.Date
  period_end            DateTime  @db.Date
  total_tasks           Int       @default(0)
  completed_tasks       Int       @default(0)
  avg_task_score        Decimal?  @db.Decimal(5, 2)
  normalized_score      Decimal?  @db.Decimal(5, 2)
  percentile            Decimal?  @db.Decimal(5, 2)
  role_mean             Decimal?  @db.Decimal(5, 2)
  role_stddev           Decimal?  @db.Decimal(5, 2)
  timeliness_score      Decimal?  @db.Decimal(5, 2)
  quality_score         Decimal?  @db.Decimal(5, 2)
  effort_accuracy_score Decimal?  @db.Decimal(5, 2)
  peer_score            Decimal?  @db.Decimal(5, 2)
  gaming_penalty_total  Decimal?  @db.Decimal(5, 2)
  remarks               String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now())
  employee              users     @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  company               companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([employee_id, period_end])
  @@index([company_id, period_end])
  @@index([period_start, period_end])
}

model role_kpi_configs {
  id                       String    @id @db.Uuid
  company_id               String    @db.Uuid
  role                     String    @db.VarChar(50)
  timeliness_weight        Decimal   @default(0.30) @db.Decimal(3, 2)
  quality_weight           Decimal   @default(0.30) @db.Decimal(3, 2)
  effort_accuracy_weight   Decimal   @default(0.25) @db.Decimal(3, 2)
  peer_review_weight       Decimal   @default(0.15) @db.Decimal(3, 2)
  normalization_enabled    Boolean   @default(true)
  created_at               DateTime  @default(now())
  updated_at               DateTime  @default(now())
  company                  companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, role])
  @@index([company_id])
}

model task_audit_logs {
  id           String    @id @db.Uuid
  task_id      String    @db.Uuid
  company_id   String    @db.Uuid
  user_id      String    @db.Uuid
  action       String    @db.VarChar(100)
  field_name   String?   @db.VarChar(100)
  old_value    String?
  new_value    String?
  timestamp    DateTime  @default(now())
  ip_address   String?   @db.VarChar(45)
  user         users     @relation(fields: [user_id], references: [id])
  company      companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([task_id, timestamp])
  @@index([company_id])
  @@index([user_id])
}

model notification_settings {
  id                    String    @id @db.Uuid
  user_id               String    @unique @db.Uuid
  company_id            String    @db.Uuid
  email_enabled         Boolean   @default(true)
  push_enabled          Boolean   @default(true)
  task_assigned         Boolean   @default(true)
  task_deadline         Boolean   @default(true)
  task_approved         Boolean   @default(true)
  task_rejected         Boolean   @default(true)
  kpi_monthly_report    Boolean   @default(true)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now())
  user                  users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company               companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
}
