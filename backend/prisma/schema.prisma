  @@index([company_id, period_end(sort: Desc)], map: "idx_kpi_history_company")
  @@index([employee_id, period_end(sort: Desc)], map: "idx_kpi_history_employee")
  @@index([period_start, period_end], map: "idx_kpi_history_period")
