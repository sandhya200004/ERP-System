// PURCHASE MANAGEMENT MODELS

model vendors {
  id                     String            @id @default(uuid()) @db.Uuid
  company_id             String            @db.Uuid
  vendor_number          String            @db.VarChar(50)
  name                   String            @db.VarChar(255)
  contact_person         String?           @db.VarChar(255)
  email                  String?           @db.VarChar(255)
  phone                  String?           @db.VarChar(50)
  tax_id                 String?           @db.VarChar(100)
  address_line1          String?           @db.VarChar(255)
  address_line2          String?           @db.VarChar(255)
  city                   String?           @db.VarChar(100)
  state                  String?           @db.VarChar(100)
  postal_code            String?           @db.VarChar(20)
  country                String?           @db.VarChar(100)
  default_currency_code  String?           @db.VarChar(3)
  payment_terms_days     Int?              @default(30)
  credit_limit           Decimal?          @db.Decimal(15, 2)
  notes                  String?
  is_active              Boolean           @default(true)
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt
  deleted_at             DateTime?
  companies              companies         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  purchase_orders        purchase_orders[]
  goods_receipts         goods_receipts[]

  @@unique([company_id, vendor_number])
  @@index([company_id, deleted_at])
  @@index([email])
}

model purchase_orders {
  id                String                 @id @default(uuid()) @db.Uuid
  company_id        String                 @db.Uuid
  po_number         String                 @db.VarChar(50)
  vendor_id         String                 @db.Uuid
  order_date        DateTime               @db.Date
  expected_date     DateTime?              @db.Date
  currency_code     String                 @default("USD") @db.VarChar(3)
  subtotal          Decimal                @default(0) @db.Decimal(15, 2)
  tax_total         Decimal                @default(0) @db.Decimal(15, 2)
  total             Decimal                @default(0) @db.Decimal(15, 2)
  status            po_status              @default(draft)
  notes             String?
  terms             String?
  created_by        String                 @db.Uuid
  approved_by       String?                @db.Uuid
  approved_at       DateTime?
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt
  deleted_at        DateTime?
  companies         companies              @relation(fields: [company_id], references: [id], onDelete: Cascade)
  vendors           vendors                @relation(fields: [vendor_id], references: [id])
  users             users                  @relation("po_created_by", fields: [created_by], references: [id])
  approver          users?                 @relation("po_approved_by", fields: [approved_by], references: [id])
  po_lines          purchase_order_lines[]
  goods_receipts    goods_receipts[]

  @@unique([company_id, po_number])
  @@index([company_id, deleted_at])
  @@index([vendor_id])
  @@index([status])
}

model purchase_order_lines {
  id               String          @id @default(uuid()) @db.Uuid
  po_id            String          @db.Uuid
  line_number      Int
  item_id          String?         @db.Uuid
  description      String
  quantity         Decimal         @db.Decimal(10, 2)
  unit_price       Decimal         @db.Decimal(15, 2)
  tax_amount       Decimal         @default(0) @db.Decimal(15, 2)
  total            Decimal         @db.Decimal(15, 2)
  received_qty     Decimal         @default(0) @db.Decimal(10, 2)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  purchase_orders  purchase_orders @relation(fields: [po_id], references: [id], onDelete: Cascade)
  items            items?          @relation(fields: [item_id], references: [id])

  @@unique([po_id, line_number])
  @@index([po_id])
}

model goods_receipts {
  id               String               @id @default(uuid()) @db.Uuid
  company_id       String               @db.Uuid
  grn_number       String               @db.VarChar(50)
  po_id            String?              @db.Uuid
  vendor_id        String               @db.Uuid
  receipt_date     DateTime             @db.Date
  status           grn_status           @default(draft)
  notes            String?
  received_by      String               @db.Uuid
  created_at       DateTime             @default(now())
  updated_at       DateTime             @updatedAt
  companies        companies            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  purchase_orders  purchase_orders?     @relation(fields: [po_id], references: [id])
  vendors          vendors              @relation(fields: [vendor_id], references: [id])
  users            users                @relation(fields: [received_by], references: [id])
  grn_lines        goods_receipt_lines[]

  @@unique([company_id, grn_number])
  @@index([company_id])
  @@index([po_id])
  @@index([vendor_id])
}

model goods_receipt_lines {
  id              String         @id @default(uuid()) @db.Uuid
  grn_id          String         @db.Uuid
  line_number     Int
  item_id         String?        @db.Uuid
  description     String
  ordered_qty     Decimal?       @db.Decimal(10, 2)
  received_qty    Decimal        @db.Decimal(10, 2)
  warehouse_id    String?        @db.Uuid
  location        String?        @db.VarChar(100)
  notes           String?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  goods_receipts  goods_receipts @relation(fields: [grn_id], references: [id], onDelete: Cascade)
  items           items?         @relation(fields: [item_id], references: [id])
  warehouses      warehouses?    @relation(fields: [warehouse_id], references: [id])

  @@unique([grn_id, line_number])
  @@index([grn_id])
}

// INVENTORY MANAGEMENT MODELS

model warehouses {
  id                  String                @id @default(uuid()) @db.Uuid
  company_id          String                @db.Uuid
  code                String                @db.VarChar(50)
  name                String                @db.VarChar(255)
  address_line1       String?               @db.VarChar(255)
  address_line2       String?               @db.VarChar(255)
  city                String?               @db.VarChar(100)
  state               String?               @db.VarChar(100)
  postal_code         String?               @db.VarChar(20)
  country             String?               @db.VarChar(100)
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  deleted_at          DateTime?
  companies           companies             @relation(fields: [company_id], references: [id], onDelete: Cascade)
  stock_levels        stock_levels[]
  stock_movements     stock_movements[]
  goods_receipt_lines goods_receipt_lines[]

  @@unique([company_id, code])
  @@index([company_id, deleted_at])
}

model stock_levels {
  id               String      @id @default(uuid()) @db.Uuid
  company_id       String      @db.Uuid
  warehouse_id     String      @db.Uuid
  item_id          String      @db.Uuid
  quantity         Decimal     @default(0) @db.Decimal(10, 2)
  reserved_qty     Decimal     @default(0) @db.Decimal(10, 2)
  available_qty    Decimal     @default(0) @db.Decimal(10, 2)
  reorder_point    Decimal?    @db.Decimal(10, 2)
  reorder_quantity Decimal?    @db.Decimal(10, 2)
  last_counted_at  DateTime?
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt
  companies        companies   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  warehouses       warehouses  @relation(fields: [warehouse_id], references: [id])
  items            items       @relation(fields: [item_id], references: [id])

  @@unique([warehouse_id, item_id])
  @@index([company_id])
  @@index([item_id])
}

model stock_movements {
  id                String             @id @default(uuid()) @db.Uuid
  company_id        String             @db.Uuid
  movement_type     stock_movement_type
  reference_type    String?            @db.VarChar(50)
  reference_id      String?            @db.Uuid
  warehouse_id      String             @db.Uuid
  item_id           String             @db.Uuid
  quantity          Decimal            @db.Decimal(10, 2)
  unit_cost         Decimal?           @db.Decimal(15, 2)
  movement_date     DateTime           @default(now())
  notes             String?
  created_by        String             @db.Uuid
  created_at        DateTime           @default(now())
  companies         companies          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  warehouses        warehouses         @relation(fields: [warehouse_id], references: [id])
  items             items              @relation(fields: [item_id], references: [id])
  users             users              @relation(fields: [created_by], references: [id])

  @@index([company_id])
  @@index([warehouse_id])
  @@index([item_id])
  @@index([movement_date])
}

enum po_status {
  draft
  submitted
  approved
  rejected
  partially_received
  received
  cancelled
}

enum grn_status {
  draft
  received
  completed
  cancelled
}

enum stock_movement_type {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}
