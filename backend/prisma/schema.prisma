  user           users?         @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([event], map: "idx_audit_event")
  @@index([task_id, timestamp(sort: Desc)], map: "idx_audit_task_id")
  @@index([timestamp(sort: Desc)], map: "idx_audit_timestamp")
  @@index([user_id], map: "idx_audit_user_id")
}

model notification_settings {
