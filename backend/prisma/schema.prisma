model employee_kpi_history {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id           String    @db.Uuid
  company_id            String    @db.Uuid
  period_start          DateTime  @db.Date
  period_end            DateTime  @db.Date
  total_tasks           Int?      @default(0)
  completed_tasks       Int?      @default(0)
  avg_task_score        Decimal?  @db.Decimal(5, 2)
  normalized_score      Decimal?  @db.Decimal(5, 2)
  percentile            Decimal?  @db.Decimal(5, 2)
  role_mean             Decimal?  @db.Decimal(5, 2)
  role_stddev           Decimal?  @db.Decimal(5, 2)
